# Copy to .env.local and fill in. .env.local is gitignored.

# ElevenLabs (read by Python tts.py via shell-out)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to the marketing/content-generator/ folder (sibling). Override only if you moved it.
CONTENT_GENERATOR_PATH=../content-generator

# Python interpreter (use "py" on Windows if "python" is not on PATH)
PYTHON_BIN=python

# VPS reserved for ops only — never used by local CRM dev
ALLOWED_VPS=187.77.111.16
